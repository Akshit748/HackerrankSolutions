-----------------------MISC------------------------------------------
SELECT NAME FROM EMPLOYEE ORDER BY NAME ASC;

SELECT NAME FROM EMPLOYEE WHERE SALARY>2000 AND MONTHS<10 ORDER BY EMPLOYEE_ID ASC;

SELECT CASE 
    WHEN A + B + C <= 2 * GREATEST(A, B, C) THEN 'Not A Triangle'
    WHEN A = B AND B = C THEN 'Equilateral'
    WHEN A = B OR A = C OR B = C THEN 'Isosceles'
    ELSE 'Scalene'
END
FROM triangles;

SELECT name || '(' || LEFT(occupation, 1) || ')' AS result
FROM OCCUPATIONS
ORDER BY name;

SELECT 'There are a total of ' || CAST(COUNT(*) AS VARCHAR(10)) || ' ' || LOWER(occupation) || 's.' AS result
FROM OCCUPATIONS
GROUP BY occupation
ORDER BY COUNT(*), occupation;

SELECT MAX(total_earnings) AS max_earnings, COUNT(*) AS employee_count FROM ( SELECT salary * months AS total_earnings FROM Employee ) AS earnings WHERE total_earnings = ( SELECT MAX(salary * months) FROM Employee );

SELECT SUM(CITY.POPULATION) FROM CITY JOIN COUNTRY ON CITY.COUNTRYCODE=COUNTRY.CODE WHERE UPPER(CONTINENT) = 'ASIA'
